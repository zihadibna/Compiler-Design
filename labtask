import re

def tokenize_code(input_string):
    # Define token categories using regular expressions
    token_specification = [
        ('KEYWORD',    r'\b(int|in|and)\b'),      # Specific keywords from your task
        ('NUMBER',     r'\b\d+\b'),               # Integer literals
        ('IDENTIFIER', r'\b[A-Za-z_][A-Za-z0-9_]*\b'), # Variable names
        ('OPERATOR',   r'[=+-]'),                 # Mathematical/Assignment operators
        ('SKIP',       r'[ \t\n]+'),              # Skip spaces and tabs
        ('MISMATCH',   r'.'),                     # Any other character
    ]
    
    # Combine patterns into a single regex
    tok_regex = '|'.join('(?P<%s>%s)' % pair for pair in token_specification)
    
    print(f"{'Token':<15} | {'Type'}")
    print("-" * 30)
    
    for mo in re.finditer(tok_regex, input_string):
        kind = mo.lastgroup
        value = mo.group()
        
        if kind == 'SKIP':
            continue
        elif kind == 'MISMATCH':
            print(f"{value:<15} | Unknown/Punctuator")
        else:
            print(f"{value:<15} | {kind}")

# The input string from your task
input_text = "Thin in a int sum = 10 and a + b = 20"

tokenize_code(input_text)
